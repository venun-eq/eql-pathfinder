{
  "model": "opus",
  "effortLevel": "medium",
  "autoCompactWindow": 250000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard-main.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\context-size.ps1\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
