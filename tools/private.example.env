# This PC's private settings: the names, with no values. Copy it to %APPDATA%\EQLPathfinder-dev\private.env and fill
# each in (docs\specs\private-settings.md). NAME=value, the value being everything after the first =: no quotes.
# IDs, logins and names only, never a token or a key. tools\private.ps1 loads them into a PowerShell by hand; the
# hourly ship loads them itself. A CI service sets the same names as secret variables and needs no file.

# Cloudflare: the account, the eqlpathfinder.com zone and its two rulesets (infra\cloudflare), the two D1 databases.
EQLP_CF_ACCOUNT_ID=
EQLP_CF_ZONE_ID=
EQLP_CF_CACHE_RULESET_ID=
EQLP_CF_REDIRECTS_RULESET_ID=
EQLP_D1_PRODUCTION=
EQLP_D1_STAGING=

# Azure code signing (infra\azure).
EQLP_AZ_SUBSCRIPTION_ID=
EQLP_AZ_OWNER_OBJECT_ID=
EQLP_AZ_IDENTITY_VALIDATION_ID=

# The NAS's ssh login, user@host: the community job and the ntfy notifications.
EQLP_NAS_LOGIN=

# Words no tracked file may hold, comma-separated: the owner's names, account names and town. They match whole words.
EQLP_DENY=
