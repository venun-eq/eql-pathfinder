<Window x:Class="EqlPathfinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EQL Pathfinder" Width="1280" Height="800" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0D1116" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/pathfinder.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Foreground" Value="#B2B9C1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1F2731"/>
                <Setter Property="Foreground" Value="#ECE7DA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="UpdatePill" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Foreground" Value="#F0C860"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="#C9A24E" Background="#2A2416" Padding="10,0,12,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3A3120"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar: drag anywhere that isn't a button; double-click maximizes; right-click opens the window menu. -->
      <Border Grid.Row="0" Background="#0D1116" BorderBrush="#222A33" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19" Stroke="#F0C860" StrokeThickness="1.6"/>
                <Path Data="M12,4.5 L14.3,12 12,19.5 9.7,12 Z" Fill="#F0C860"/>
                <Ellipse Canvas.Left="10.7" Canvas.Top="10.7" Width="2.6" Height="2.6" Fill="#0D1116"/>
              </Canvas>
            </Viewbox>
            <StackPanel x:Name="Wordmark" Orientation="Horizontal" Margin="9,1,0,0"/>
            <Border Width="1" Height="18" Background="#2A333E" Margin="12,0,12,0"/>
            <TextBlock x:Name="WhoText" Foreground="#D8DDE2" VerticalAlignment="Center"/>
            <TextBlock x:Name="ServerText" Foreground="#8D959E" VerticalAlignment="Center"/>
            <Border x:Name="WhoChip" Margin="10,0,0,0" Padding="10,2" CornerRadius="11" Background="#212A35"
                    BorderBrush="#2F3945" BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="WhoChipText" FontSize="12" Foreground="#C9CFD6"/>
            </Border>
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" ToolTip="Minimize">
              <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True"/>
            </Button>
            <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" ToolTip="Maximize">
              <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True"/>
            </Button>
            <Button x:Name="CloseBtn" Style="{StaticResource CloseCaptionButton}" ToolTip="Close (Pathfinder keeps running in the tray)">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/>
            </Button>
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8D959E" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Margin="7,0,0,0" FontSize="12" Foreground="#8D959E" VerticalAlignment="Center"/>
            <Button x:Name="UpdateBtn" Style="{StaticResource UpdatePill}" Margin="14,0,0,0" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <Path Data="M6,1 V8 M3,5.5 L6,8.5 9,5.5 M1.5,11 H10.5" Stroke="#F0C860" StrokeThickness="1.6" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="UpdateText" FontSize="12" Foreground="#F0C860" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- A 3 px frame around the page leaves the window edges to Windows, so they still resize. -->
      <Grid Grid.Row="1" Background="#11161C">
        <Rectangle Width="3" HorizontalAlignment="Left" Fill="#0D1116"/>
        <wv2:WebView2 x:Name="Web" Margin="3,0,3,3" DefaultBackgroundColor="#11161C"/>
        <TextBlock x:Name="Fallback" Visibility="Collapsed" Margin="32" TextWrapping="Wrap" FontSize="14"
                   Foreground="{StaticResource Text}"/>
      </Grid>
    </Grid>
  </Border>
</Window>
