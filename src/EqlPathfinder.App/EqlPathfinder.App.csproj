<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EQLPathfinder</AssemblyName>
    <RootNamespace>EqlPathfinder.App</RootNamespace>
    <StartupObject>EqlPathfinder.App.Program</StartupObject>
    <ApplicationIcon>Assets\pathfinder.ico</ApplicationIcon>
    <Product>EQL Pathfinder</Product>
    <Version>0.10.34</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; keep its names out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Where installed copies look for updates: tools\release.ps1 passes -p:UpdateFeed=<folder or https URL>. -->
  <ItemGroup Condition="'$(UpdateFeed)' != ''">
    <AssemblyMetadata Include="UpdateFeed" Value="$(UpdateFeed)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EqlPathfinder.Engine\EqlPathfinder.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\pathfinder.ico" />
    <Resource Include="Assets\pathfinder-256.png" />
    <Resource Include="Assets\Fonts\Cinzel-Bold.ttf" />
    <!-- The SIL Open Font License travels with the font. -->
    <Content Include="Assets\Fonts\OFL-Cinzel.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
