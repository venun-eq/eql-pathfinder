<Window x:Class="EqlPathfinder.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Welcome to EQL Pathfinder" Width="1000" Height="680" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#0D1116" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/pathfinder.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0D1116" BorderBrush="#222A33" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Viewbox Width="18" Height="18">
            <Canvas Width="24" Height="24">
              <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19" Stroke="#F0C860" StrokeThickness="1.6"/>
              <Path Data="M12,4.5 L14.3,12 12,19.5 9.7,12 Z" Fill="#F0C860"/>
              <Ellipse Canvas.Left="10.7" Canvas.Top="10.7" Width="2.6" Height="2.6" Fill="#0D1116"/>
            </Canvas>
          </Viewbox>
          <StackPanel x:Name="TitleWordmark" Orientation="Horizontal" Margin="9,1,0,0"/>
          <TextBlock x:Name="TitleNote" Text="welcome" Margin="12,0,0,0" Foreground="#8D959E" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="TitleClose" DockPanel.Dock="Right" Width="46" Height="40" Focusable="False" ToolTip="Close"
                WindowChrome.IsHitTestVisibleInChrome="True" Foreground="#B2B9C1">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="Transparent">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button x:Name="TitleMin" DockPanel.Dock="Right" Width="46" Height="40" Focusable="False" ToolTip="Minimize"
                WindowChrome.IsHitTestVisibleInChrome="True" Foreground="#B2B9C1">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="Transparent">
                <Path Data="M0,0.5 H10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" SnapsToDevicePixels="True"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#1F2731"/>
                  <Setter Property="Foreground" Value="#ECE7DA"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Background="#11161C">
      <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#11161C"/>
      <TextBlock x:Name="Fallback" Visibility="Collapsed" Margin="32" TextWrapping="Wrap" FontSize="14" Foreground="#ECE7DA"/>
    </Grid>
  </Grid>
</Window>
