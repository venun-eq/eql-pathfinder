<Application x:Class="EqlPathfinder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#141920"/>
    <SolidColorBrush x:Key="Panel" Color="#1C232C"/>
    <SolidColorBrush x:Key="Line" Color="#2A333E"/>
    <SolidColorBrush x:Key="Text" Color="#E8E4D8"/>
    <SolidColorBrush x:Key="Muted" Color="#AEB6BE"/>
    <SolidColorBrush x:Key="Faint" Color="#7F8790"/>
    <SolidColorBrush x:Key="Gold" Color="#F0C860"/>
    <SolidColorBrush x:Key="GoldDim" Color="#C9A24E"/>
    <SolidColorBrush x:Key="Good" Color="#8FD18F"/>
    <SolidColorBrush x:Key="Warn" Color="#E8907E"/>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#141920"/>
      <Setter Property="Background" Value="#F0C860"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F7D987"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#E8E4D8"/>
      <Setter Property="Background" Value="#2A333E"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
  </Application.Resources>
</Application>
